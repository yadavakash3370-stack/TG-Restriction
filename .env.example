# Telegram API (from https://my.telegram.org)
API_ID=1234567
API_HASH=your_api_hash_here

# Bot Token (from @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Owner Telegram ID (your ID)
OWNER_ID=987654321

# Bot signature
BOT_SIGNATURE=Extracted by @XyrDeveloper

# Bandwidth limit in GB (default: 4.5)
BANDWIDTH_LIMIT_GB=4.5

# Port for Render web service
PORT=8080
